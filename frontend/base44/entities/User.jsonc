    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "cuil": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "locality": {
      "type": "string"
    },
    "cvu_cbu": {
      "type": "string"
    }
  }
}