{
  "name": "RaffleParticipation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "raffle_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "terms_version_id": {
      "type": "string"
    },
    "payment_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_verified_by": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "raffle_id",
    "status",
    "requested_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service"
      }
    },
    "update": {
      "user_condition": {
        "role": "service"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service"
      }
    }
  }
}